				qcom,pre-scaling = <0x01 0x01>;
				qcom,adc-tm-type = <0x01>;
			};

			pm7550ba_display_therm {
				reg = <0x74d>;
				label = "pm7550ba_display_therm";
				qcom,ratiometric;
				qcom,pre-scaling = <0x01 0x01>;
				qcom,adc-tm-type = <0x01>;
			};

			pm7550ba_charger_therm {
				reg = <0x749>;
				label = "pm7550ba_charger_therm";
				qcom,ratiometric;
				qcom,pre-scaling = <0x01 0x01>;
				qcom,adc-tm-type = <0x01>;
			};

			pm7550ba_batt_therm {
				reg = <0x744>;
