					mux {
						function = "qup2_se0_l1";
						pins = "gpio1";
					};

					config {
						qcom,apps;
						bias-disable;
						drive-strength = <0x04>;
						pins = "gpio1";
					};
				};

				onyx_qupv3_se8_i2c_sleep {
					phandle = <0x1aa>;

					mux {
						function = "gpio";
						pins = "gpio0\0gpio1";
					};

					config {
						qcom,remote;
						drive-strength = <0x04>;
						pins = "gpio0\0gpio1";
					};
				};
			};

			cam_sensor_mclk1_active {
				phandle = <0x1a4>;

				mux {
					function = "cam_mclk";
					pins = "gpio65";
				};

				config {
					drive-strength = <0x04>;
					bias-disable;
					pins = "gpio65";
				};
			};

			cam_sensor_mclk1_suspend {
				phandle = <0x1a5>;

				mux {
					function = "cam_mclk";
					pins = "gpio65";
				};

				config {
					drive-strength = <0x04>;
					bias-pull-down;
					pins = "gpio65";
				};
			};
		};
	};

