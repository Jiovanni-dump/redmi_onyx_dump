				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,pre-scaling = <0x01 0x01>;
				qcom,adc-tm-type = <0x01>;
			};

			pmxr2230_conn_therm2 {
				reg = <0x14c>;
				label = "pmxr2230_conn_therm2";
				qcom,ratiometric;
				qcom,pre-scaling = <0x01 0x01>;
				qcom,adc-tm-type = <0x01>;
			};

			pm7550ba_wifi_therm {
