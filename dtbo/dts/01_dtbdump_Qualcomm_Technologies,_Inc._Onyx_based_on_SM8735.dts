	fragment@43 {
		target = <0xffffffff>;

		__overlay__ {

			xo_therm {

				xo_therm_default {
					pins = "gpio10";
					bias-high-impedance;
					phandle = <0x1f>;
				};
			};

			conn_therm2 {

				conn_therm2_default {
					pins = "gpio7";
					bias-high-impedance;
					phandle = <0x20>;
				};
			};
		};
	};

	fragment@44 {
		target = <0xffffffff>;

		__overlay__ {
			pinctrl-names = "default";
			pinctrl-0 = <0x1f 0x20 0x21 0x22 0x23>;

			pmxr2230_xo_therm {
				reg = <0x14d>;
				label = "pmxr2230_xo_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,pre-scaling = <0x01 0x01>;
				qcom,adc-tm-type = <0x01>;
			};

			pmxr2230_pa_therm0 {
				reg = <0x144>;
				label = "pmxr2230_pa_therm0";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
